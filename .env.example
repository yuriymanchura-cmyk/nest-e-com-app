POSTGRES_USER=nest_user
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=nest_commerce
POSTGRES_PORT=5433

DATABASE_URL=postgresql://nest_user:replace-with-local-password@localhost:5433/nest_commerce?schema=public

JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
JWT_REFRESH_TOKEN_TTL=7d

ADMIN_EMAIL=admin@example.com

MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-local-webhook-secret
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=no-reply@your-verified-domain.com
